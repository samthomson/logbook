{
  "name": "logbook-pwa",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run test:performance",
    "lint": "oxlint",
    "test": "npm run test:unit && npm run test:browser",
    "test:unit": "vitest run",
    "test:browser": "npm run test:public-shell && npm run test:playback && npm run test:admin-layout && npm run test:concurrent-recording && npm run test:resume-cache && npm run test:navigation-cache",
    "test:public-shell": "node scripts/public-shell-qa.mjs",
    "test:playback": "node scripts/playback-qa.mjs",
    "test:admin-layout": "node scripts/admin-layout-qa.mjs",
    "test:concurrent-recording": "node scripts/concurrent-recording-qa.mjs",
    "test:resume-cache": "node scripts/resume-cache-qa.mjs",
    "test:navigation-cache": "node scripts/navigation-cache-qa.mjs",
    "test:performance": "node scripts/performance-budget.mjs",
    "preview": "vite preview"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "applesauce-core": "^6.2.0",
    "applesauce-signers": "^6.2.2",
    "nostr-tools": "^2.23.12",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "rxjs": "^7.8.2",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "fake-indexeddb": "^6.2.5",
    "oxlint": "^1.71.0",
    "puppeteer": "25.3.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "workbox-core": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  },
  "allowScripts": {
    "puppeteer@25.3.0": true
  }
}
