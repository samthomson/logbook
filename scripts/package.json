{
  "name": "logbook-scripts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "watch-compass": "node --loader ts-node/esm watch-compass.ts",
    "stitch": "tsx stitch.ts",
    "publish-rss": "node --loader ts-node/esm publish-rss.ts",
    "typecheck": "tsc --noEmit",
    "test": "COMPASS_PUBKEY=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa RELAYS=wss://relay.test DISCOVERY_RELAYS=wss://discovery.test BLOSSOM_SERVERS=https://blossom.test LOGBOOK_BASE_URL=http://localhost:8080 tsx --test test/*.test.ts",
    "rss": "tsx publish-rss.ts",
    "watch": "tsx watch-compass.ts",
    "transcribe-missing": "tsx transcribe-missing.ts",
    "seed-whitelist": "tsx seed-whitelist.mts",
    "seed-newsletter": "tsx seed-newsletter.mts",
    "seed": "tsx seed.mts",
    "generate-intros": "tsx generate-intros.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.27.0",
    "applesauce-core": "^6.2.0",
    "applesauce-signers": "^6.2.2",
    "node-fetch": "^3.3.2",
    "nostr-tools": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/node-fetch": "^2.6.13",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.1",
    "typescript": "^5.5.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
