# Worker configuration template. The deployed /etc/logbook/logbook.env also
# contains COMPASS_BUNKER_URI and COMPASS_BUNKER_CLIENT_KEY; keep it root-owned
# and mode 0600, never commit or copy it into the repository.
LOGBOOK_BASE_URL=https://podcast.nostrcompass.org
# Optional. Defaults to public LOGBOOK_BASE_URL/feed.xml. A loopback origin
# bypasses public-host evidence and therefore must be an explicit exception.
# LOGBOOK_FEED_READBACK_URL=http://127.0.0.1:8080/feed.xml
LOGBOOK_STATIC_DIR=/var/www/logbook
LOGBOOK_AUDIO_DIR=/var/www/logbook/audio
# whisper.cpp weights for transcription; the Docker image bakes these in.
LOGBOOK_WHISPER_MODEL=/opt/logbook/scripts/models/ggml-small.en.bin
