# Public configuration only. Keep signer credentials out of this file.
# The worker reads the existing Compass NIP-46 session from
# /home/logbook/.config/compass-publish/{bunker.json,client_key}.
LOGBOOK_BASE_URL=https://podcast.nostrcompass.org
LOGBOOK_STATIC_DIR=/var/www/logbook
LOGBOOK_AUDIO_DIR=/var/www/logbook/audio
