# Copy to .env and fill in. Gitignored. Shared deployment names are reused by
# the PWA build, trusted worker, and seed tools as applicable.

COMPASS_PUBKEY=
# Producers: may curate and release episodes, and manage contributor access.
# `npm run seed` writes these into the Compass-signed producer list.
ADMIN_PUBKEYS=

# Write/query: segments, manifests, whitelists, publish.
RELAYS=wss://your-relay.example
# Read-only: kind 0, NIP-05, Compass kind 30023 newsletters. Never used for publish.
DISCOVERY_RELAYS=wss://nos.lol,wss://relay.ditto.pub,wss://relay.primal.net

BLOSSOM_SERVERS=https://your-blossom.example
LOGBOOK_BASE_URL=http://localhost:8080
# Optional worker read-back endpoint. Defaults to $LOGBOOK_BASE_URL/feed.xml.
# Set this when the worker reaches the hosted feed through a different URL.
# LOGBOOK_FEED_READBACK_URL=http://127.0.0.1:8080/feed.xml
PWA_DEV_PORT=5180
# SPA only. Must not be 8080 — that port is the feed origin nginx.
PWA_PORT=8081

# Where nsyte publishes the site announcement + static blobs (not DISCOVERY_RELAYS).
NSYTE_RELAYS=wss://your-relay.example
NSYTE_BLOSSOM_SERVERS=https://your-blossom.example

# Already-authorized NIP-46 session for worker signing. Same vars in Dokploy.
# The bunker itself is externally managed; this repository never starts it.
COMPASS_BUNKER_URI=bunker://…
COMPASS_BUNKER_CLIENT_KEY=
# nsyte uses its separately preconfigured OS keychain/encrypted credential store.
