# Copy to .env and fill in. Gitignored. Same names in PWA and worker.

COMPASS_PUBKEY=
ADMIN_PUBKEYS=

# Write/query: segments, manifests, whitelists, publish.
RELAYS=wss://your-relay.example
# Read-only: kind 0 profiles + NIP-05 hints. Never used for publish.
DISCOVERY_RELAYS=wss://nos.lol,wss://relay.damus.io,wss://relay.primal.net

BLOSSOM_SERVERS=https://your-blossom.example
LOGBOOK_BASE_URL=http://localhost:8080
PWA_DEV_PORT=5180
PWA_PORT=8080

# NIP-46 bunker session dir (bunker.json + client_key).
COMPASS_BUNKER_DIR=./.secrets/compass-publish
